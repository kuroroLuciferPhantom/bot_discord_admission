generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model GuildSettings {
  guildId String @id
  roleStacking Boolean @default(true)
  checksPerWeek Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revision Int @default(0)
}

model RoleRule {
  id String @id @default(uuid())
  guildId String
  group String
  chainId Int
  contract String
  tokenIds String[]
  minimum String
  roleId String
  @@unique([guildId, roleId])
  @@unique([guildId, group, minimum])
  @@index([guildId])
}

model ManagedRole {
  guildId String
  roleId String
  @@id([guildId, roleId])
}

model RoleMember {
  guildId String
  userId String
  lastCheckedAt DateTime?
  active Boolean @default(false)
  nextCheckAt DateTime? @default(now())
  leaseId String?
  leaseUntil DateTime?
  attempts Int @default(0)
  lastError String?
  @@index([active, nextCheckAt])
  @@id([guildId, userId])
}

enum ChallengeStatus {
  PENDING
  VERIFIED
  CANCELLED
  EXPIRED
}

model Wallet {
  guildId String
  address String
  userId String
  active Boolean @default(true)
  verifiedAt DateTime
  @@id([guildId, address])
  @@index([guildId, userId, active])
}

model WalletChallenge {
  id String @id @default(uuid())
  guildId String
  userId String
  address String
  chainId Int
  amountWei String
  startBlock BigInt
  createdAt DateTime
  expiresAt DateTime
  status ChallengeStatus @default(PENDING)
  transactionHash String?
  @@unique([chainId, amountWei])
  @@unique([chainId, transactionHash])
  @@index([guildId, userId, createdAt])
  @@index([status, expiresAt])
}
