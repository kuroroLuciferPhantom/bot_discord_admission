# Never commit real credentials.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Required for commands:deploy -- --guild (test server).
DISCORD_TEST_GUILD_ID=
DATABASE_URL=postgresql://holder:CHANGE_ME@localhost:5432/holder
# Docker Compose only; use the same password in DATABASE_URL (host: db).
POSTGRES_PASSWORD=
# Optional until wallet verification is enabled. HTTPS Alchemy RPC URLs; never log them.
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
# Alchemy NFT API key (Ethereum and Polygon enabled on the same application).
ALCHEMY_API_KEY=
# Optional: 32 random bytes in canonical Base64, kept on the host only.
# Required for /settings alchemy; back it up separately from database dumps.
ALCHEMY_ENCRYPTION_KEY=
# Explicit opt-in after validating bot permissions and running the acceptance checklist.
SCHEDULER_ENABLED=false
